{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/display/**",
              "components/system/**",
              "ui_kits/jukebox-screen/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hanken Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Hanken Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:live|neutral|hi)$/]",
        "message": "<Badge> tone must be one of 'live' | 'neutral' | 'hi'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dial'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|size|label|mode|style|key|ref|className|style|children)$/]",
        "message": "<Dial> doesn't accept that prop. Declared props: value, min, max, size, label, mode, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dial'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:volume|value)$/]",
        "message": "<Dial> mode must be one of 'volume' | 'value'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|art|artColor|playing|selected|trailing|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, subtitle, art, artColor, playing, selected, trailing, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoomChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|playing|grouped|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RoomChip> doesn't accept that prop. Declared props: name, playing, grouped, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Scrubber'] > JSXAttribute > JSXIdentifier[name!=/^(?:elapsed|duration|live|style|key|ref|className|style|children)$/]",
        "message": "<Scrubber> doesn't accept that prop. Declared props: elapsed, duration, live, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:room|grouped|time|source|style|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: room, grouped, time, source, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransportButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|variant|active|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TransportButton> doesn't accept that prop. Declared props: icon, size, variant, active, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransportButton'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:play|pause|back|next|prev|room|menu|shuffle|repeat|add|more)$/]",
        "message": "<TransportButton> icon must be one of 'play' | 'pause' | 'back' | 'next' | 'prev' | 'room' | 'menu' | 'shuffle' | 'repeat' | 'add' | 'more'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransportButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<TransportButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransportButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|elevated|solid)$/]",
        "message": "<TransportButton> variant must be one of 'ghost' | 'elevated' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VolumeBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|muted|style|key|ref|className|style|children)$/]",
        "message": "<VolumeBar> doesn't accept that prop. Declared props: value, muted, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],

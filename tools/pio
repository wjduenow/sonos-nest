#!/usr/bin/env python3
"""pio wrapper that gives each silicon its own PlatformIO package tree.

WHY THIS EXISTS
---------------
PlatformIO keeps platforms, frameworks and toolchains in ONE directory per machine
(``PLATFORMIO_CORE_DIR``, default ``~/.platformio``), shared by every checkout and worktree. This
project builds two different chips, and their platforms require **twelve package names in common**
at incompatible versions -- ``framework-arduinoespressif32`` (Arduino 2.0.17 vs 3.3.11),
``tool-esptoolpy``, ``toolchain-riscv32-esp`` and friends. Only one version of each can occupy the
tree, so crossing silicon evicts the other one and the next build back reinstalls it.

Measured before this wrapper (2026-08-11, PlatformIO 6.1.19): ``nest`` -> ``sonos-jukebox`` ->
``nest`` reinstalled 3 packages on the way back, including the S3 Arduino core, adding ~25 s and a
hard dependency on the network. It self-heals, so it is a delay rather than a break -- but it also
means two people (or two agent sessions) building different silicon at once fight over one tree.

Giving each platform its own tree removes the contention entirely. The cost is a few GB of
duplicated toolchain, which this project has (~600 GB free on the dev machine).

HOW THE TREE IS CHOSEN
----------------------
From ``platformio.ini``, not from a hardcoded list of env names: resolve the env's ``extends``
chain, read its effective ``platform``, and map that string to a tree. Add a new ``jukebox-*`` env
and it lands in the right tree with no change here.

  ESP32-S3 envs (platform espressif32@6.9.0)   -> ~/.platformio        (the default; unchanged)
  ESP32-P4 envs (platform pioarduino ...zip)   -> ~/.platformio-p4

The S3 tree deliberately stays at the stock location: it is where a plain ``pio`` install already
put everything, so nobody has to re-download 5 GB to adopt this, and every doc that says
``~/.platformio/packages/...`` for an S3 env stays true.

USAGE
-----
  tools/pio run -e nest                     # same arguments as pio, any subcommand
  tools/pio run -e sonos-jukebox -t upload
  tools/pio --print-core-dir -e sonos-jukebox   # just print the tree (used by CI and by docs)

Set ``SONOS_PIO_VERBOSE=1`` to have it announce which tree it picked.
"""

import configparser
import os
import shutil
import subprocess
import sys
import tempfile

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
INI = os.path.join(REPO_ROOT, "platformio.ini")

# platform string -> core dir. Matched as a substring of the env's effective `platform` value, so
# the pinned pioarduino release URL matches on "pioarduino" and survives a version bump. First
# match wins; anything unmatched falls through to DEFAULT_CORE_DIR.
TREES = [
    ("pioarduino", "~/.platformio-p4"),   # ESP32-P4 (jukebox) -- Arduino 3.3.11 / IDF 5.5.5
]
DEFAULT_CORE_DIR = "~/.platformio"        # ESP32-S3 (nest, sleep-machine, sleep-button)


def load_ini():
    # interpolation=None: platformio.ini uses ${...} for its own substitution, which configparser
    # would otherwise try to expand and choke on.
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.read(INI)
    return cp


def effective_platform(cp, env):
    """The `platform` an env resolves to, following `extends` (and [env] as the implicit base)."""
    seen = set()
    section = f"env:{env}"
    while section and section not in seen:
        seen.add(section)
        if not cp.has_section(section):
            break
        if cp.has_option(section, "platform"):
            return cp.get(section, "platform").strip()
        section = cp.get(section, "extends").strip() if cp.has_option(section, "extends") else None
    # Unset anywhere up the chain -> the [env] default applies.
    if cp.has_section("env") and cp.has_option("env", "platform"):
        return cp.get("env", "platform").strip()
    return ""


def core_dir_for(env):
    if env is None:                       # no -e given: pio uses default_envs
        cp = load_ini()
        defaults = cp.get("platformio", "default_envs", fallback="").replace(",", " ").split()
        env = defaults[0] if defaults else None
        if env is None:
            return os.path.expanduser(DEFAULT_CORE_DIR)
    plat = effective_platform(load_ini(), env)
    for needle, path in TREES:
        if needle in plat:
            return os.path.expanduser(path)
    return os.path.expanduser(DEFAULT_CORE_DIR)


def envs_from_args(argv):
    """Every -e/--environment value on the command line."""
    out, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("-e", "--environment") and i + 1 < len(argv):
            out.append(argv[i + 1]); i += 2; continue
        for pre in ("-e=", "--environment="):
            if a.startswith(pre):
                out.append(a[len(pre):]); break
        i += 1
    return out


def main():
    argv = sys.argv[1:]
    print_only = "--print-core-dir" in argv
    if print_only:
        argv = [a for a in argv if a != "--print-core-dir"]

    envs = envs_from_args(argv)
    dirs = {core_dir_for(e) for e in envs} or {core_dir_for(None)}

    # One invocation cannot serve two trees -- PLATFORMIO_CORE_DIR is a single value. Refuse rather
    # than silently building half the envs against the wrong packages.
    if len(dirs) > 1:
        sys.stderr.write(
            "tools/pio: these envs need different package trees, so they cannot share one command:\n"
            + "".join(f"  -e {e:16} -> {core_dir_for(e)}\n" for e in envs)
            + "Run them as separate commands.\n")
        return 2

    core_dir = dirs.pop()
    if print_only:
        print(core_dir)
        return 0

    env = dict(os.environ, PLATFORMIO_CORE_DIR=core_dir)
    # PIN THE P4 PLATFORM'S OWN PlatformIO. pioarduino builds a private venv (<core>/penv) and
    # installs `pioarduino>=6.1.19` into it with uv -- unbounded. pioarduino 6.2.0 (2026-09-15)
    # moves tool-scons to 4.11.1, and the ESP-IDF lib rebuild (custom_sdkconfig) runs that pio,
    # which swaps scons-local 4.11 into the tree UNDER a build already running on 4.8.1:
    #   ModuleNotFoundError: No module named 'SCons.Tool.FortranCommon'
    # Same failure the Core pin in .github/workflows/firmware.yml exists for, by a second door. It
    # hits only a FRESH P4 tree -- an existing penv already satisfies >=6.1.19 and is never
    # upgraded -- which is why it surfaced when CI's package cache missed, and why a dev machine
    # with a populated ~/.platformio-p4 never sees it. uv reads UV_CONSTRAINT (space-separated
    # files), so this caps it without patching the platform. Harmless for the S3 tree: its platform
    # does not use uv. To move the pin, bump it here and prove it on a cold jukebox build.
    # UV_CONSTRAINT is SPACE-separated, so a checkout path with a space in it would split into
    # paths that do not exist -- and uv fails the install outright ("File not found"), which is
    # worse than no pin. A relative path is no answer: uv runs inside the nested IDF build, not
    # from the repo root. So copy the file somewhere space-free when the real path is not.
    constraints = os.path.join(REPO_ROOT, "tools", "uv-constraints.txt")
    if any(c.isspace() for c in constraints):
        copy = os.path.join(tempfile.gettempdir(), "sonos-nest-uv-constraints.txt")
        shutil.copyfile(constraints, copy)
        constraints = copy
    if any(c.isspace() for c in constraints):
        sys.stderr.write("tools/pio: no whitespace-free path for the uv constraints file; the "
                         "P4 pioarduino pin is NOT applied (see the comment above).\n")
    else:
        env["UV_CONSTRAINT"] = " ".join(filter(None, [os.environ.get("UV_CONSTRAINT"),
                                                      constraints]))
    if os.environ.get("SONOS_PIO_VERBOSE"):
        sys.stderr.write(f"tools/pio: PLATFORMIO_CORE_DIR={core_dir}\n")

    # Find pio without requiring it on PATH -- the stock installer leaves it in the default tree's
    # penv, which is where this repo's docs tell you to add to PATH.
    pio = shutil.which("pio") or os.path.expanduser("~/.platformio/penv/bin/pio")
    if not os.path.exists(pio):
        sys.stderr.write("tools/pio: no `pio` on PATH or at ~/.platformio/penv/bin/pio.\n"
                         "See docs/dev-setup.md.\n")
        return 127
    return subprocess.call([pio] + argv, env=env)


if __name__ == "__main__":
    sys.exit(main())
